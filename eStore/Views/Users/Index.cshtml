@model IEnumerable<eStore.Models.User.UserViewModel>

@{
    ViewData["Title"] = "Users List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "User";
}

<h1>Danh sách người dùng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>

<table id="userTable" class="table table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FullName)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Role)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.Avatar)</th>
            

            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Role)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.Avatar))
                    {
                        <img src="@item.Avatar" alt="Avatar" width="50" height="50" class="rounded-circle" />
                    }
                </td>

                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.UserID" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i> Xem
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.UserID" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        @if (item.CanDetele)
                        {
                            <a asp-action="Delete" asp-route-id="@item.UserID" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i> Xóa
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>
                                <i class="fas fa-trash"></i> Không thể xóa
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        <script>
            $(document).ready(function () {
                $('#userTable').DataTable({
                    "paging": true,       // Bật phân trang
                    "lengthMenu": [5, 10, 25, 50], // Các tùy chọn số dòng trên mỗi trang
                    "searching": true,    // Bật tìm kiếm
                    "ordering": true,     // Bật sắp xếp cột
                    "info": true,         // Hiển thị tổng số bản ghi
                    "language": {
                        "lengthMenu": "Hiển thị _MENU_ sản phẩm mỗi trang",
                        "zeroRecords": "Không tìm thấy sản phẩm nào",
                        "info": "Trang _PAGE_ trên _PAGES_",
                        "infoEmpty": "Không có dữ liệu",
                        "search": "🔍 Tìm kiếm:",
                        "paginate": {
                            "first": "Trang đầu",
                            "last": "Trang cuối",
                            "next": "▶",
                            "previous": "◀"
                        }
                    }
                });
            });
        </script>

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}