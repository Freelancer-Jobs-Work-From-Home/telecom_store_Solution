@model eStore.Models.User.UserViewModel

@{
    ViewData["Title"] = "Tạo Người Dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "User";
}
<!-- Flatpickr styles & scripts -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<h2 class="text-center my-4 text-primary">👤 Thêm Người Dùng Mới</h2>

<div class="card shadow-lg border-0 rounded p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        @Html.AntiForgeryToken()

        <!-- Họ và tên -->
        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-bold">📛 Họ và tên</label>
            <input asp-for="FullName" class="form-control shadow-sm" placeholder="Nhập họ và tên" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <!-- Email -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">📧 Email</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-envelope"></i></span>
                <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <!-- Mật khẩu -->
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-bold">🔑 Mật khẩu</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-lock"></i></span>
                <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <!-- Địa chỉ -->
        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-bold">🏠 Địa chỉ</label>
            <input asp-for="Address" class="form-control shadow-sm" placeholder="Nhập địa chỉ" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <!-- Vai trò -->
        <div class="mb-3">
            <label asp-for="Role" class="form-label fw-bold">🛂 Vai trò</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-user-tag"></i></span>
                <select asp-for="Role" class="form-select">
                    <option value="Admin">Quản trị viên</option>
                    <option value="User">Người dùng</option>
                </select>
            </div>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <!-- Hình ảnh -->
        <div class="mb-3">
            <label class="form-label fw-bold">📷 Hình ảnh</label>
            <div class="input-group shadow-sm">
                <input type="file" asp-for="ImageFile" class="form-control d-none" id="fileInput" onchange="updateFileName()" />
                <label for="fileInput" class="input-group-text btn btn-outline-primary">
                    <i class="fas fa-upload"></i> Chọn ảnh
                </label>
                <input type="text" id="fileName" class="form-control bg-white" readonly placeholder="Chưa chọn tệp" />
            </div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <!-- Ngày sinh -->
        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label fw-bold">🎂 Ngày sinh</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-calendar-alt"></i></span>
                <input asp-for="DateOfBirth" type="text" id="dateOfBirth" class="form-control" placeholder="Chọn ngày sinh" />
            </div>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <!-- Nút lưu & quay lại -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <button type="submit" class="btn btn-success px-4 shadow-sm">
                <i class="fas fa-save"></i> Lưu
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function updateFileName() {
            const fileInput = document.getElementById('fileInput');
            const fileName = document.getElementById('fileName');
            fileName.value = fileInput.files.length > 0 ? fileInput.files[0].name : "Chưa chọn tệp";
        }

        document.addEventListener("DOMContentLoaded", function () {
            flatpickr("#dateOfBirth", {
                dateFormat: "Y-m-d", // Kết hợp đúng định dạng phía server "yyyy-MM-dd"
                maxDate: "today",
                allowInput: true,
                locale: "vn"
            });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px;
        font-size: 16px;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .btn {
        border-radius: 8px;
        padding: 10px 16px;
    }

    .btn-outline-primary {
        border-radius: 8px;
        cursor: pointer;
    }
</style>
