@model IEnumerable<eStore.Models.Category.CategoryViewModel>

@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Category";
}

<h1 class="text-center my-4">Danh sách danh mục</h1>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Tạo danh mục mới
    </a>
    <div>
        <a asp-action="ImportCsv" class="btn btn-primary">
            <i class="fas fa-file-import"></i> Nhập CSV
        </a>
        <a asp-action="ExportCsv" class="btn btn-warning">
            <i class="fas fa-file-export"></i> Xuất CSV
        </a>
    </div>
</div>

<div class="table-responsive-md">
    <table id="categoryTable" class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.CategoryName)</th>
               
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.CategoryName)</td>
                    
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.CategoryID" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>Sửa
                            </a>
                            @if (item.CanDelete)
                            {
                                <a asp-action="Delete" asp-route-id="@item.CategoryID" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled>
                                    <i class="fas fa-trash"></i> Không thể xóa
                                </button>
                            }
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        <script>
            $(document).ready(function () {
                $('#categoryTable').DataTable({
                    "paging": true,       // Bật phân trang
                    "lengthMenu": [5, 10, 25, 50], // Các tùy chọn số dòng trên mỗi trang
                    "searching": true,    // Bật tìm kiếm
                    "ordering": true,     // Bật sắp xếp cột
                    "info": true,         // Hiển thị tổng số bản ghi
                    "language": {
                        "lengthMenu": "Hiển thị _MENU_ sản phẩm mỗi trang",
                        "zeroRecords": "Không tìm thấy sản phẩm nào",
                        "info": "Trang _PAGE_ trên _PAGES_",
                        "infoEmpty": "Không có dữ liệu",
                        "search": "🔍 Tìm kiếm:",
                        "paginate": {
                            "first": "Trang đầu",
                            "last": "Trang cuối",
                            "next": "▶",
                            "previous": "◀"
                        }
                    }
                });
            });
        </script>

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}