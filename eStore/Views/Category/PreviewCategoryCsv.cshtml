@model List<eStore.Models.Category.CategoryViewModel>

@{
    ViewData["Title"] = "Xem trước nhập danh mục từ CSV";
}

<h2>Xem trước nhập danh mục từ CSV</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || Model.Count == 0)
{
    <p>Không có dữ liệu để hiển thị.</p>
}
else
{
    <form asp-action="ProcessCsvImport" method="post">
        <input type="hidden" name="PreviewDataJson" value="@Newtonsoft.Json.JsonConvert.SerializeObject(Model)" />
        <input type="hidden" name="confirmed" value="true" />

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tên danh mục</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model[i].CategoryName</td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success">Xác nhận nhập danh mục</button>
    </form>
}
