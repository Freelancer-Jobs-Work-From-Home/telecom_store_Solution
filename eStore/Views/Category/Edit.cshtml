@model eStore.Models.Category.CategoryViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Product";
}

<h2 class="text-center my-4">Edit Product</h2>

<div class="card shadow p-4">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        <!-- Trường ẩn để lưu ID sản phẩm -->
        <input type="hidden" asp-for="CategoryID" />

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">Tên sản phẩm</label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-10">
            <button type="submit" class="btn btn-primary px-4">
                <i class="fas fa-save"></i> Cập nhật
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
