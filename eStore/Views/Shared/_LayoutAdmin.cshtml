<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="76x76" href="~/Admin/assets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="~Admin/assets/img/favicon.ico">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>Light Bootstrap Dashboard - Free Bootstrap 4 Admin Dashboard by Creative Tim</title>
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <!--     Fonts and icons     -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" />

    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- CSS Files -->
    <link href="~/Admin/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Admin/assets/css/light-bootstrap-dashboard.css?v=2.0.0 " rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <!-- DataTables JavaScript -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="~/Admin/assets/css/demo.css" rel="stylesheet" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="wrapper">
       @* SideBar *@
        <div class="sidebar" data-image="~Admin/assets/img/sidebar-5.jpg">
            <!--
                Tip 1: You can change the color of the sidebar using: data-color="purple | blue | green | orange | red"

                Tip 2: you can also add an image using data-image tag
            -->
            <div class="sidebar-wrapper">
                <div class="logo">
                    <a href="#" class="simple-text">
                        Telecom Store
                    </a>
                </div>
                <ul class="nav">
                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">
                            <i class="nc-icon nc-chart-pie-35"></i>
                            <p>Trang chủ</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "User" ? "active" : "")">
                        <a class="nav-link" asp-controller="Users" asp-action="Index">
                            <i class="nc-icon nc-circle-09"></i>
                            <p>Quản lý người dùng</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Product" ? "active" : "")">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="nc-icon nc-notes"></i>
                            <p>Quản lý sản phẩm</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Category" ? "active" : "")">
                        <a class="nav-link" asp-controller="Category" asp-action="Index">
                            <i class="nc-icon nc-paper-2"></i>
                            <p>Quản lý danh mục</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Order" ? "active" : "")">
                        <a class="nav-link" asp-controller="Order" asp-action="ManageOrders">
                            <i class="nc-icon nc-cart-simple"></i>
                            <p>Quản lý đơn hàng</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Feedback" ? "active" : "")">
                        <a class="nav-link" asp-controller="Feedback" asp-action="Index">
                            <i class="nc-icon nc-email-85"></i>
                            <p>Quản lý phản hồi</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Review" ? "active" : "")">
                        <a class="nav-link" asp-controller="Review" asp-action="getListReview">
                            <i class="nc-icon nc-favourite-28"></i>
                            <p>Quản lý đánh giá</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Coupon" ? "active" : "")">
                        <a class="nav-link" asp-controller="Coupon" asp-action="Index">
                            <i class="nc-icon nc-tag-content"></i>
                            <p>Quản lý mã giảm giá</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewData["ActivePage"]?.ToString() == "Delete" ? "active" : "")">
                        <a class="nav-link" asp-controller="Auth" asp-action="Logout">
                            <i class="nc-icon nc-button-power"></i>
                            <p>Đăng xuất</p>
                        </a>
                    </li>
                </ul>

            </div>
        </div>
       @*MainContent *@
        <div class="main-panel">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg " color-on-scroll="500">
                <div class="container-fluid">
                    <div class="collapse navbar-collapse justify-content-end" id="navigation">
                        <ul class="nav navbar-nav mr-auto">
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Admin" class="nav-link" data-toggle="dropdown">
                                    <span class="d-lg-none">Dashboard</span>
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="no-icon">👤 @User.Identity.Name</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</body>

@await RenderSectionAsync("Scripts", required: false)


</html>
