@model eStore.Models.Feedback.FeedbackViewModel

<div class="feedback_form_area">
    <div class="row">
        <div class="col-12">
            <div class="block_title">
                <h3>Gửi phản hồi của bạn</h3>
            </div>
        </div>
    </div>
    <form asp-controller="Feedback" asp-action="SubmitFeedback" method="post">
        <!-- Trường ẩn UserID -->
        <input type="hidden" asp-for="UserID" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FullName">Họ và tên:</label>
                    <input type="text" class="form-control" asp-for="FullName" readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Email">Email:</label>
                    <input type="email" class="form-control" asp-for="Email" readonly>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group">
                    <label asp-for="Message">Phản hồi:</label>
                    <textarea class="form-control" asp-for="Message" rows="4" required></textarea>
                </div>
            </div>
            <div class="col-12 text-center">
                <button type="submit" class="btn btn-primary">Gửi phản hồi</button>
            </div>
        </div>
    </form>
</div>
