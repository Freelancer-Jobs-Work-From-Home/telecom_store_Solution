@model IEnumerable<eStore.Models.Order.OrderViewModel>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Lịch sử đặt hàng</li>
    </ol>
</nav>

<div class="container mt-4">
    <h2 class="mb-4 text-center">📜 Lịch sử đơn hàng</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Giá trị</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr class="text-center">
                            <td>@order.OrderID</td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold">@order.TotalPrice.ToString("N0") VNĐ</td>
                            <td>
                                <span class="badge bg-@(order.Status == "Completed" ? "success" : order.Status == "Pending" ? "warning" : "danger")">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <!-- Nút xem chi tiết -->
                                <button id="btn-toggle-@order.OrderID" class="btn btn-outline-primary btn-sm" onclick="toggleDetails('@order.OrderID')">
                                    <i class="fas fa-eye"></i> Xem
                                </button>

                                <!-- Nút hủy đơn hàng -->
                                <button class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#cancelModal"
                                        data-order-id="@order.OrderID"
                                        onclick="setCancelOrderId('@order.OrderID')"
                                @(order.Status != "Pending" ? "disabled" : "")>
                                    <i class="fas fa-times"></i> Hủy đơn
                                </button>
                            </td>
                        </tr>

                        <!-- Chi tiết đơn hàng (ẩn/hiện) -->
                        <tr id="details-@order.OrderID" class="order-details" style="display: none;">
                            <td colspan="5">
                                <div class="p-3 border rounded bg-light">
                                    <h5 class="text-primary">📦 Chi tiết đơn hàng</h5>
                                    <table class="table table-sm mt-2">
                                        <thead>
                                            <tr>
                                                <th>Sản phẩm</th>
                                                <th>Số lượng</th>
                                                <th>Giá</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detail in order.OrderDetails)
                                            {
                                                <tr>
                                                    <td>@detail.ProductName</td>
                                                    <td class="text-center">@detail.Quantity</td>
                                                    <td class="fw-bold">@detail.Price.ToString("N0") VNĐ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> Bạn chưa có đơn hàng nào.
        </div>
    }
</div>

<!-- Modal Xác nhận hủy đơn -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelModalLabel">Xác nhận hủy đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn hủy đơn hàng này không?
            </div>
            <div class="modal-footer">
                <form id="cancelOrderForm" method="post" asp-action="CancelOrder" asp-controller="Order">
                    <input type="hidden" name="orderId" id="cancelOrderId">
                    <button type="submit" class="btn btn-danger">Xác nhận</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleDetails(orderId) {
        var row = document.getElementById("details-" + orderId);
        var button = document.getElementById("btn-toggle-" + orderId);

        if (row.style.display === "none") {
            row.style.display = "table-row";
            button.innerHTML = '<i class="fas fa-eye-slash"></i> Ẩn';
            button.classList.remove("btn-outline-primary");
            button.classList.add("btn-outline-secondary");
        } else {
            row.style.display = "none";
            button.innerHTML = '<i class="fas fa-eye"></i> Xem';
            button.classList.remove("btn-outline-secondary");
            button.classList.add("btn-outline-primary");
        }
    }

    function setCancelOrderId(orderId) {
        document.getElementById("cancelOrderId").value = orderId;
    }
</script>

<!-- Bootstrap & FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

