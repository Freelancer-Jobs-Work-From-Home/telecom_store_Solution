@model IEnumerable<eStore.Models.Order.OrderViewModel>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Order";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Quản lý đơn hàng</li>
    </ol>
</nav>
<div class="container mt-4">
    <h2 class="mb-4">📦 Quản lý đơn hàng</h2>

    <table id="orderTable" class="table table-bordered table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn hàng</th>
                <th>Khách hàng</th>
                <th>Giá trị</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Trạng thái</th>
                <th>Hành động</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.FullName</td>
                    <td><strong>@order.TotalPrice.ToString("N0") đ</strong></td>
                    <td>
                        <span class="badge
                            @(order.Status == "Pending" ? "bg-warning text-dark" :
                              order.Status == "Completed" ? "bg-success" :
                              "bg-danger")">
                            @if (order.Status == "Pending")
                            {
                                <i class="fas fa-hourglass-half"></i>
                            }
                            else if (order.Status == "Completed")
                            {
                                <i class="fas fa-check-circle"></i>
                            }
                            else
                            {
                                <i class="fas fa-times-circle"></i>
                            }
                            @order.Status
                        </span>
                    </td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <form asp-action="UpdateOrderStatus" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="orderId" value="@order.OrderID" />
                                <div class="dropdown">
                                    <select name="status" class="form-select me-3 custom-select">
                                        <option value="Pending" selected="@("Pending" == order.Status)">🕒 Chờ xử lý</option>
                                        <option value="Completed">✅ Hoàn thành</option>
                                        <option value="Canceled">❌ Hủy</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> Lưu</button>
                            </form>
                        }
                        else if (order.Status == "Completed")
                        {
                            <span class="text-success"><i class="fas fa-check-circle"></i> Hoàn thành</span>
                        }
                        else
                        {
                            <span class="text-danger"><i class="fas fa-times-circle"></i> Đã hủy</span>
                        }
                    </td>

                    <td>
                        <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#orderDetailModal-@order.OrderID">
                            <i class="fas fa-eye"></i> Xem chi tiết
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @foreach (var order in Model)
    {
        <div class="modal fade" id="orderDetailModal-@order.OrderID" tabindex="-1" aria-labelledby="orderDetailLabel-@order.OrderID" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="orderDetailLabel-@order.OrderID">Chi tiết đơn hàng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>Mã đơn hàng:</strong> @order.OrderID</p>
                        <p><strong>Khách hàng:</strong> @order.FullName</p>
                        <p><strong>Ngày đặt:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Tổng tiền:</strong> @order.TotalPrice.ToString("N0") đ</p>
                        <p>
                            <strong>Trạng thái:</strong>
                            <span class="badge
                            @(order.Status == "Pending" ? "bg-warning text-dark" :
                              order.Status == "Completed" ? "bg-success" :
                              "bg-danger")">
                                @order.Status
                            </span>
                        </p>

                        <h6>🛒 Sản phẩm trong đơn hàng:</h6>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Price.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</div>

@section Scripts {
    @{
        <script>
            $(document).ready(function () {
                $('#orderTable').DataTable({
                    "paging": true,       // Bật phân trang
                    "lengthMenu": [5, 10, 25, 50], // Các tùy chọn số dòng trên mỗi trang
                    "searching": true,    // Bật tìm kiếm
                    "ordering": true,     // Bật sắp xếp cột
                    "info": true,         // Hiển thị tổng số bản ghi
                    "language": {
                        "lengthMenu": "Hiển thị _MENU_ sản phẩm mỗi trang",
                        "zeroRecords": "Không tìm thấy sản phẩm nào",
                        "info": "Trang _PAGE_ trên _PAGES_",
                        "infoEmpty": "Không có dữ liệu",
                        "search": "🔍 Tìm kiếm:",
                        "paginate": {
                            "first": "Trang đầu",
                            "last": "Trang cuối",
                            "next": "▶",
                            "previous": "◀"
                        }
                    }
                });
            });
        </script>

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .custom-select {
        padding: 10px 14px;
        font-size: 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
        line-height: 1.5; /* Đảm bảo dòng chữ không bị cắt */
        height: auto; /* Cho phép tùy chỉnh chiều cao */
        min-height: 40px; /* Đảm bảo chiều cao đủ hiển thị */
    }

        .custom-select:hover {
            background-color: #f8f9fa;
        }

    .btn-sm {
        padding: 8px 14px;
        font-size: 14px;
        border-radius: 6px;
        margin-left: 12px;
    }

    .me-3 {
        margin-right: 12px !important;
    }
</style>
