@model IEnumerable<eStore.Models.Order.OrderViewModel>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Order";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" rel="stylesheet" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Quản lý đơn hàng</li>
    </ol>
</nav>

<div class="container mt-4">
    <h2 class="mb-4">📦 Quản lý đơn hàng</h2>

    <table id="orderTable" class="table table-bordered table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn hàng</th>
                <th>Khách hàng</th>
                <th>Giá trị</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Cập nhật trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr id="order-row-@order.OrderID">
                    <td>@order.OrderID</td>
                    <td>@order.FullName</td>
                    <td><strong>@order.TotalPrice.ToString("N0") đ</strong></td>
                    <td id="status-display-@order.OrderID">
                        <span class="badge
                            @(order.Status == "Pending" ? "bg-warning text-dark" :
                              order.Status == "Completed" ? "bg-success" :
                              "bg-danger")">
                            @order.Status
                        </span>
                    </td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <select class="form-select me-2 status-select" data-order-id="@order.OrderID">
                                <option value="Pending" selected="@(order.Status == "Pending")">🕒 Chờ xử lý</option>
                                <option value="Completed" selected="@(order.Status == "Completed")">✅ Hoàn thành</option>
                                <option value="Canceled" selected="@(order.Status == "Canceled")">❌ Hủy</option>
                            </select>
                            <button class="btn btn-primary btn-sm btn-update-status" data-order-id="@order.OrderID">
                                <i class="fas fa-save"></i> Lưu
                            </button>
                        </div>
                    </td>
                    <td>
                        <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#orderDetailModal-@order.OrderID">
                            <i class="fas fa-eye"></i> Xem chi tiết
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Modal Chi tiết -->
    @foreach (var order in Model)
    {
        <div class="modal fade" id="orderDetailModal-@order.OrderID" tabindex="-1" aria-labelledby="orderDetailLabel-@order.OrderID" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="orderDetailLabel-@order.OrderID">Chi tiết đơn hàng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>Mã đơn hàng:</strong> @order.OrderID</p>
                        <p><strong>Khách hàng:</strong> @order.FullName</p>
                        <p><strong>Ngày đặt:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Tổng tiền:</strong> @order.TotalPrice.ToString("N0") đ</p>
                        <p><strong>Trạng thái:</strong> @order.Status</p>
                        <h6>🛒 Sản phẩm trong đơn hàng:</h6>
                        <table class="table table-bordered">
                            <thead>
                                <tr><th>Sản phẩm</th><th>Số lượng</th><th>Giá</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Price.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
    $('#orderTable').DataTable();

    $('.btn-update-status').on('click', function () {
        var orderId = $(this).data('order-id');
        var newStatus = $('.status-select[data-order-id="' + orderId + '"]').val();

        $.ajax({
            url: '/api/order/update-status-ajax', // chỉnh theo API thực tế
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                OrderID: orderId,
                Status: newStatus
            }),
            success: function (response) {
                if (response.success) {
                    $('#status-display-' + orderId).html(response.statusHtml);
                } else {
                    alert('Lỗi: ' + response.message);
                }
            },
            error: function () {
                alert('Cập nhật thất bại. Vui lòng thử lại.');
            }
        });
    });
});

    </script>
}
