@model IEnumerable<eStore.Models.Review.ReviewViewModel>

@{
    ViewData["Title"] = "Danh sách đánh giá";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Review";
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h1 class="text-center my-4">Danh sách đánh giá</h1>

<div class="table-responsive-md">
    <table id="ReviewTable" class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Tên người dùng</th>
                <th>Tên sản phẩm</th>
                <th>Rating</th>
                <th>Ngày đánh giá</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.UserName)</td>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Rating) ⭐</td>
                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-info btn-sm detail-btn" data-id="@item.ReviewID" data-bs-toggle="modal" data-bs-target="#detailReviewModal">
                                <i class="fas fa-eye"></i> Xem
                            </button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="@item.ReviewID" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                <i class="fas fa-trash"></i> Xóa
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<form id="deleteForm" method="post" asp-action="Delete" asp-controller="Review">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteReviewId" />
</form>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa đánh giá này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xóa</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Review -->
<div class="modal fade" id="detailReviewModal" tabindex="-1" aria-labelledby="detailReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết đánh giá</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Người dùng:</strong> <span id="detailUserName"></span></p>
                <p><strong>Sản phẩm:</strong> <span id="detailProductName"></span></p>
                <p><strong>Đánh giá:</strong> <span id="detailRating"></span> ⭐</p>
                <p><strong>Nội dung:</strong> <span id="detailComment"></span></p>
                <p><strong>Ngày đánh giá:</strong> <span id="detailCreatedAt"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let reviewIdToDelete = null;

            // Khi nhấn nút Xóa, lưu ID review cần xóa
            $('.delete-btn').on('click', function () {
                reviewIdToDelete = $(this).data('id');
            });

            // Khi nhấn nút xác nhận xóa trong modal
            $('#confirmDeleteBtn').on('click', function () {
                if (reviewIdToDelete) {
                    $('#deleteReviewId').val(reviewIdToDelete);
                    $('#deleteForm').submit();
                }
            });

            // Khi nhấn nút Xem chi tiết
            $('.detail-btn').on('click', function () {
                const reviewId = $(this).data('id');
                const review = @Html.Raw(Json.Serialize(Model));
                const selectedReview = review.find(r => r.ReviewID === reviewId);

                if (selectedReview) {
                    $('#detailUserName').text(selectedReview.UserName);
                    $('#detailProductName').text(selectedReview.ProductName);
                    $('#detailRating').text(selectedReview.Rating);
                    $('#detailComment').text(selectedReview.Comment);
                    $('#detailCreatedAt').text(selectedReview.CreatedAt);
                }
            });

            $('#ReviewTable').DataTable({
                "paging": true,
                "lengthMenu": [5, 10, 25, 50],
                "searching": true,
                "ordering": true,
                "info": true,
                "language": {
                    "lengthMenu": "Hiển thị _MENU_ đánh giá mỗi trang",
                    "zeroRecords": "Không tìm thấy đánh giá nào",
                    "info": "Trang _PAGE_ trên _PAGES_",
                    "infoEmpty": "Không có dữ liệu",
                    "search": "🔍 Tìm kiếm:",
                    "paginate": {
                        "first": "Trang đầu",
                        "last": "Trang cuối",
                        "next": "▶",
                        "previous": "◀"
                    }
                }
            });
        });
    </script>
}
