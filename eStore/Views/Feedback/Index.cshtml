@model IEnumerable<eStore.Models.Feedback.FeedbackViewModel>

@{
    ViewData["Title"] = "Danh sách phản hồi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Feedback";
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h1 class="text-center my-4">Danh sách sản phẩm</h1>

<div class="table-responsive-md">
    <!-- Dùng table-responsive-md để hỗ trợ iPad -->
    <table id="FeedbackTable" class="table table-hover">
        <thead class="table-dark">
            <tr>
                
                <th>Tên người dùng</th>
                <th>Email người dùng</th>
                <th>Nội dung phản hồi</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Message)</td>
                    
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-danger btn-sm delete-btn" data-id="@item.FeedbackID" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                <i class="fas fa-trash"></i> Xóa
                            </button>
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
<form id="deleteForm" method="post" asp-action="Delete" asp-controller="Feedback">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteFeedbackId" />
</form>


<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa phản hồi này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xóa</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        

        

        <script>
            $(document).ready(function () {
                let feedbackIdToDelete = null;

                // Khi nhấn nút Xóa, lưu ID phản hồi cần xóa
                $('.delete-btn').on('click', function () {
                    feedbackIdToDelete = $(this).data('id');
                });

                // Khi nhấn nút xác nhận xóa trong modal
                $('#confirmDeleteBtn').on('click', function () {
                    if (feedbackIdToDelete) {
                        // Gán ID vào input hidden trong form
                        $('#deleteFeedbackId').val(feedbackIdToDelete);

                        // Gửi form để xóa
                        $('#deleteForm').submit();
                    }
                });
            });
        </script>

        <script>
            $(document).ready(function () {
                $('#FeedbackTable').DataTable({
                    "paging": true,       // Bật phân trang
                    "lengthMenu": [5, 10, 25, 50], // Các tùy chọn số dòng trên mỗi trang
                    "searching": true,    // Bật tìm kiếm
                    "ordering": true,     // Bật sắp xếp cột
                    "info": true,         // Hiển thị tổng số bản ghi
                    "language": {
                        "lengthMenu": "Hiển thị _MENU_ phản hồi mỗi trang",
                        "zeroRecords": "Không tìm thấy phản hồi nào",
                        "info": "Trang _PAGE_ trên _PAGES_",
                        "infoEmpty": "Không có dữ liệu",
                        "search": "🔍 Tìm kiếm:",
                        "paginate": {
                            "first": "Trang đầu",
                            "last": "Trang cuối",
                            "next": "▶",
                            "previous": "◀"
                        }
                    }
                });
            });
        </script>


        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}