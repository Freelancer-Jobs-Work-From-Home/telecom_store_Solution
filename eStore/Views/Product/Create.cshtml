@model eStore.Models.Product.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["ActivePage"] = "Product";
}

<h2 class="text-center my-4 text-primary">➕ Thêm Sản Phẩm Mới</h2>

<div class="card shadow-lg border-0 rounded p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">🛒 Tên sản phẩm</label>
            <input asp-for="Name" class="form-control shadow-sm" placeholder="Nhập tên sản phẩm" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Giá sản phẩm -->
        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-bold">💰 Giá</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-dollar-sign"></i></span>
                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Nhập giá" />
            </div>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <!-- Số lượng -->
        <div class="mb-3">
            <label asp-for="Stock" class="form-label fw-bold">📦 Số lượng</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-box"></i></span>
                <input asp-for="Stock" class="form-control" type="number" placeholder="Nhập số lượng" />
            </div>
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <!-- Mô tả sản phẩm -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">📝 Miêu tả</label>
            <textarea asp-for="Description" class="form-control shadow-sm" rows="3" placeholder="Nhập mô tả sản phẩm"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- Hình ảnh -->
        <div class="mb-3">
            <label class="form-label fw-bold">📷 Hình ảnh</label>
            <div class="input-group shadow-sm">
                <input type="file" asp-for="ImageFile" class="form-control d-none" id="fileInput" onchange="updateFileName()" />
                <label for="fileInput" class="input-group-text btn btn-outline-primary">
                    <i class="fas fa-upload"></i> Chọn ảnh
                </label>
                <input type="text" id="fileName" class="form-control bg-white" readonly placeholder="Chưa chọn tệp" />
            </div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <!-- Danh mục -->
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label fw-bold">📋 Danh mục</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-light"><i class="fas fa-list"></i></span>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories as List<eStore.Models.Category.CategoryViewModel>)
                        {
                            <option value="@category.CategoryID">@category.CategoryName</option>
                        }
                    }
                    </select>
            </div>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <!-- Button lưu & quay lại -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <button type="submit" class="btn btn-success px-4 shadow-sm">
                <i class="fas fa-save"></i> Lưu
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        <script>
            function updateFileName() {
                const fileInput = document.getElementById('fileInput');
                const fileName = document.getElementById('fileName');
                fileName.value = fileInput.files.length > 0 ? fileInput.files[0].name : "Chưa chọn tệp";
            }
        </script>
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px;
        font-size: 16px;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .btn {
        border-radius: 8px;
        padding: 10px 16px;
    }

    .btn-outline-primary {
        border-radius: 8px;
        cursor: pointer;
    }
</style>
